# Variables requeridas por el pipeline ETL (copie este archivo a .env)
#
# 1. MONGODB_URI: cadena de conexion de MongoDB Atlas (sin exponer en GitHub).
#    Nota de compatibilidad: si el proyecto ya usa MONGO_URI, se respeta esa
#    variable (MONGODB_URI tiene prioridad).
# 2. MONGODB_DATABASE: nombre de la base de datos.
# 3. MONGODB_COLLECTIONS (opcional): colecciones a extraer, separadas por coma.
# 4. MONGO_BATCH_SIZE (opcional): tamanio de lote de lectura.
# 5. DATA_LAKE_ROOT (opcional): carpeta raiz del Data Lake local.

MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/
MONGODB_DATABASE=sample_mflix
MONGODB_COLLECTIONS=users,movies,comments,theaters
MONGO_BATCH_SIZE=1000
DATA_LAKE_ROOT=data_lake