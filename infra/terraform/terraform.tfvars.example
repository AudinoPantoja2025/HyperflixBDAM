# ============================================================================
# Copie este archivo a terraform.tfvars y ajuste los valores NO sensibles.
# Las credenciales (public/private key y passwords de base de datos) NO van
# aqui: se pasan como variables de entorno TF_VAR_* (quedan fuera del repo).
#
#   $env:TF_VAR_mongodbatlas_public_key  = "<public key>"
#   $env:TF_VAR_mongodbatlas_private_key = "<private key>"
#   $env:TF_VAR_mongodbatlas_org_id      = "<org id>"
#   $env:TF_VAR_db_readwrite_password    = "<password pipeline>"
#   $env:TF_VAR_db_readonly_password     = "<password bi>"
# ============================================================================

project_name   = "BD-Parcial"
cluster_name   = "BD-Parcial-Cluster"

# M0 (gratis, academico) o M10 (estandar del curso, ~$57 USD/mes)
cluster_tier   = "M0"

# Cluster dedicado (M10+): AWS / us-east-1 / Replica Set de 3 nodos
# cluster_provider          = "AWS"
cloud_region               = "US_EAST_1"
replica_electable_nodes    = 3

# Red (seccion 4.1.2 del documento)
ip_access_cidr_block       = "0.0.0.0/0"

# Usuarios de base de datos (seccion 4.1.3)
db_readwrite_username      = "jupagaso_db_user"
db_readonly_username       = "analytics_ro"